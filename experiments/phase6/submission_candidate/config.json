{
  "model": "project.py:SmallUNet",
  "initialization": "random, default PyTorch",
  "external_data": false,
  "pretrained_weights": false,
  "seed": 5489,
  "split": "split.json",
  "train_images": 4500,
  "validation_images": 500,
  "input_size": 256,
  "training_epochs": 10,
  "batch_size": 8,
  "shuffle_train": true,
  "shuffle_validation": false,
  "dataloader_workers": 0,
  "cpu_threads": 4,
  "optimizer": "Adam",
  "optimizer_arguments": {
    "lr": 0.001,
    "betas": [
      0.9,
      0.999
    ],
    "eps": 1e-08,
    "weight_decay": 0
  },
  "input_processing": "bilinear RGB resize, divide by 255; nearest-neighbor binary mask resize",
  "augmentation": "none",
  "precision": "float32 (no AMP)",
  "training_loss": "positive-weighted BCEWithLogits + unchanged per-image soft Dice loss",
  "dice_smoothing": 1,
  "train_fg_ratio": 0.11570463053385417,
  "bce_pos_weight": 2.764542720554796,
  "weight_rule": "sqrt(training background pixels / foreground pixels)",
  "validation_loss": "unweighted BCEWithLogits + soft Dice, same as V1",
  "selection_metric": "micro foreground IoU at 256x256 with threshold 0.5",
  "threshold": 0.5,
  "torch": "2.9.1+cu128",
  "cuda": "12.8",
  "gpu": "NVIDIA GeForce RTX 5090",
  "python": "3.11.16",
  "runtime_scope": "train and validation passes, synchronized, excluding preprocessing and file writes",
  "peak_memory_scope": "torch.cuda.max_memory_allocated, not total device VRAM"
}